---
/**
 * simple 템플릿
 * 제목 + 설명 + 기본 신청 폼으로 구성된 가장 단순한 랜딩 레이아웃
 */
import type { LandingConfig } from '../../lib/types';
import SimpleApplicationForm from '../forms/SimpleApplicationForm.astro';

interface Props {
  landing: LandingConfig;
}

const { landing } = Astro.props;
---

<section class="simple-landing">
  {
    landing.heroImage && (
      <div class="hero">
        <img src={landing.heroImage} alt="" />
      </div>
    )
  }

  <header class="header">
    <h1 class="title">{landing.title}</h1>
    <p class="description">{landing.description}</p>
  </header>

  <div class="form-panel">
    <SimpleApplicationForm landing={landing} />
  </div>
</section>

<style>
  .simple-landing {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .hero {
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--color-surface);
    box-shadow: var(--shadow);
  }

  .hero img {
    display: block;
    width: 100%;
    height: auto;
  }

  .header {
    padding: 8px 4px 0;
  }

  .title {
    margin: 0 0 10px;
    font-size: 24px;
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .description {
    margin: 0;
    font-size: 15px;
    color: var(--color-muted);
    line-height: 1.55;
    white-space: pre-line;
  }

  .form-panel {
    padding: 20px 16px;
    background: var(--color-surface);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
</style>
