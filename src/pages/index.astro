---
/**
 * 루트 페이지
 * 개발자가 등록된 랜딩페이지 목록을 확인하고 이동할 수 있습니다.
 */
import { getAllLandings } from '../data/landings';

const landings = getAllLandings();
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Kakao Landing Pages</title>
  </head>
  <body>
    <main class="wrap">
      <h1>Kakao Landing Pages</h1>
      <p class="subtitle">등록된 카카오 챗봇 랜딩페이지 목록입니다.</p>

      {
        landings.length === 0 ? (
          <p class="empty">등록된 랜딩이 없습니다.</p>
        ) : (
          <ul class="list">
            {landings.map((landing) => (
              <li>
                <a href={`/kakao/${landing.slug}/`}>
                  <span class="slug">{landing.slug}</span>
                  <span class="meta">
                    {landing.title}
                    <span class="template">[{landing.template}]</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </main>
  </body>
</html>

<style>
  :root {
    --font-family:
      'Apple SD Gothic Neo', 'Noto Sans KR', 'Malgun Gothic', sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    font-family: var(--font-family);
    background: #f5f6f8;
    color: #1a1a1a;
  }

  .wrap {
    max-width: 640px;
    margin: 0 auto;
    padding: 48px 20px;
  }

  h1 {
    margin: 0 0 8px;
    font-size: 28px;
    letter-spacing: -0.02em;
  }

  .subtitle {
    margin: 0 0 28px;
    color: #666;
    font-size: 15px;
  }

  .empty {
    color: #888;
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .list a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 16px;
    background: #fff;
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
  }

  .list a:hover {
    outline: 1px solid #fee500;
  }

  .slug {
    font-weight: 700;
    font-size: 16px;
  }

  .meta {
    font-size: 13px;
    color: #666;
  }

  .template {
    margin-left: 6px;
    color: #999;
  }
</style>
