# 프론트엔드에서 호출하는 공개 API 베이스 URL
# 민감한 값(API Secret, DB 비밀번호, Private Key 등)은 절대 넣지 마세요.
#
# ⚠️ Astro는 PUBLIC_ 접두사가 붙은 변수만 브라우저(클라이언트) 코드에 주입합니다.
# Cloudflare Pages / GitHub에도 반드시 PUBLIC_KOTI_API_BASE_URL 로 등록하세요.
#
# landing-001 은 샘플(LandingApplyForm3)과 동일하게 아래 경로를 사용합니다.
#   POST {PUBLIC_KOTI_API_BASE_URL}/check
#   POST {PUBLIC_KOTI_API_BASE_URL}/landing-apply/input
#   POST {PUBLIC_KOTI_API_BASE_URL}/input
PUBLIC_KOTI_API_BASE_URL=https://adimg.ikoreatm.com/api

# 사이트 원본 URL (og:image 절대 경로용, 끝에 / 없이)
# 예: https://your-project.pages.dev 또는 커스텀 도메인
# PUBLIC_SITE_URL=https://example.com
